import { ScrollView } from "scrollview.slint";
import { Theme, Middle, Label, Tip } from "theme.slint";
import { ActionButton, IconButton, Avatar, CallButton, VolumeSlider, MenuItem } from "controls.slint";

export struct PersonRow {
    id: string, name: string, status: string, muted: bool, deafened: bool, speaking: bool, connected: bool, initial: string, tint: color, picture: image,
    /// Sharing their screen.
    live: bool,
    /// Their camera is on.
    video: bool,
    /// This account, in a call.
    local: bool,
    /// This account, in the call on another client: dimmed, without icons.
    elsewhere: bool,
    /// Muted or deafened by the Discord server, whose icons show in red.
    server-muted: bool,
    server-deafened: bool,
    /// Who they are across calls, by Discord or Matrix user id, which their
    /// volumes are remembered by.
    person: string,
}

// Marks someone sharing their screen, as Discord's red LIVE tag does.
// Clickable when it opens the stream.
export component LivePill inherits Rectangle {
    in property <bool> clickable;
    in property <string> label: "Watch stream";
    callback clicked;
    width: live-text.preferred-width + 10px; height: 16px; border-radius: 8px;
    background: root.clickable && live-touch.has-hover ? Theme.danger-hover : Theme.danger;
    accessible-role: button; accessible-enabled: root.clickable; accessible-label: root.clickable ? root.label : "Live";
    accessible-action-default => { if root.clickable { root.clicked(); } }
    live-text := Text { text: "LIVE"; color: Theme.on-danger; font-size: 10px; font-weight: 800; letter-spacing: 0.4px; }
    live-touch := TouchArea {
        enabled: root.clickable; mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Who watches a stream, over its top right as Discord shows them: an eye and
// how many, then the first three's avatars overlapping and how many more.
// Hovering names them all.
export component ViewerStack inherits Rectangle {
    in property <[PersonRow]> viewers;
    /// "Watching: " and their names, for the tooltip.
    in property <string> names;
    property <int> faces: min(3, root.viewers.length);
    property <length> pictures: root.faces > 0 ? 22px + (root.faces - 1) * 15px : 0px;
    visible: root.viewers.length > 0;
    width: 8px + 16px + 4px + count.preferred-width + 6px + root.pictures + (root.viewers.length > 3 ? 4px + more.preferred-width : 0px) + 6px;
    height: 30px; border-radius: 15px; background: #000000a6;
    accessible-role: text; accessible-label: root.names;
    Image { x: 8px; width: 16px; height: 16px; source: @image-url("icons/eye.svg"); colorize: #ffffff; }
    count := Text {
        x: 28px; text: root.viewers.length; color: #ffffff; font-size: 13px; font-weight: 700;
    }
    for viewer[index] in root.viewers: Rectangle {
        visible: index < 3;
        x: 28px + count.preferred-width + 6px + index * 15px;
        width: 26px; height: 26px; border-radius: 13px; background: #000000;
        Avatar { size: 22px; initial: viewer.initial; tint: viewer.tint; picture: viewer.picture; }
    }
    more := Text {
        visible: root.viewers.length > 3;
        x: 28px + count.preferred-width + 6px + root.pictures + 4px;
        text: "+" + (root.viewers.length - 3); color: #ffffff; font-size: 13px; font-weight: 700;
    }
    TouchArea {
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.names; Tip.side = 2;
                Tip.x = root.absolute-position.x + root.width / 2; Tip.y = root.absolute-position.y + root.height;
            } else if Tip.text == root.names {
                Tip.text = "";
            }
        }
    }
}

// How the call's connection is doing, for the signal icon's tooltip and the
// popout it opens, as Discord's voice panel shows them. Rust fills in the
// numbers only when `read` asks, while one of them shows.
export global CallLink {
    /// The call measures its connection, as a Discord call does.
    in property <bool> measured;
    /// 0 while unknown, then 1 fine, 2 average and 3 bad, as Discord grades it.
    in property <int> quality;
    /// Media leaves end-to-end encrypted.
    in property <bool> end-to-end;
    /// The last ping and the average, as "42 ms"; empty until one comes.
    in property <string> ping;
    in property <string> average;
    /// The share of this account's packets lost, as "1.2%"; empty until known.
    in property <string> loss;
    /// The last five minutes of pings as path commands in a 300 by 100 box,
    /// and the ping at its top, in milliseconds.
    in property <string> graph;
    in property <int> graph-top;
    /// The voice privacy code in groups of five digits, while the call is
    /// end-to-end encrypted with someone else in it.
    in property <[string]> code;
    callback read();
}

// The signal strength Discord's voice panel shows: bars and a colour by how
// good the connection is, grey while it's unknown.
export component SignalIcon inherits Image {
    in property <int> quality;
    source: root.quality == 3 ? @image-url("icons/signal-low.svg")
        : root.quality == 2 ? @image-url("icons/signal-medium.svg") : @image-url("icons/signal-high.svg");
    colorize: root.quality == 1 ? Theme.live : root.quality == 2 ? Theme.accent
        : root.quality == 3 ? Theme.danger : Theme.muted;
    image-fit: contain;
}

// Over the call's status or its signal icon: the ping as a tooltip, and a
// click opens the details, at this point in the window.
export component LinkTouch inherits TouchArea {
    in property <int> tip-side: 0;
    callback open(length, length, length, length);
    enabled: CallLink.measured;
    mouse-cursor: CallLink.measured ? MouseCursor.pointer : MouseCursor.default;
    changed has-hover => {
        if self.has-hover {
            CallLink.read();
            if CallLink.ping != "" {
                Tip.text = CallLink.ping; Tip.side = root.tip-side;
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.y = root.tip-side == 2 ? self.absolute-position.y + self.height : self.absolute-position.y;
            }
        } else if Tip.text == CallLink.ping {
            Tip.text = "";
        }
    }
    clicked => {
        Tip.text = "";
        root.open(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
}

component LinkTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 28px; width: tab-text.preferred-width;
    accessible-role: tab; accessible-label: root.text; accessible-item-selected: root.on;
    accessible-action-default => { root.clicked(); }
    tab-text := Text {
        y: 0; text: root.text; font-size: 14px; font-weight: 700;
        color: root.on || tab-touch.has-hover ? Theme.text : Theme.muted;
    }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.on ? Theme.accent : transparent; }
    tab-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// A label and its value in bold, as the popout's rows are.
component LinkRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px; alignment: start;
    Text { text: root.label; color: Theme.secondary; font-size: 14px; }
    Text { text: root.value; color: Theme.text; font-size: 14px; font-weight: 700; }
}

// The call's connection in detail, as Discord's popout from its voice panel:
// a graph of the ping over the last five minutes, the average and last ping,
// the packets lost, and while end-to-end encrypted, the voice privacy code to
// compare with the others in the call.
export component CallLinkCard inherits Rectangle {
    out property <length> content-height: link-content.preferred-height;
    callback copy(string);
    property <bool> privacy;
    property <bool> copied;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox; accessible-label: "Voice details";
    init => { CallLink.read(); }
    Timer { interval: 1s; running: true; triggered => { CallLink.read(); } }
    Timer { interval: 2s; running: root.copied; triggered => { root.copied = false; } }
    link-content := VerticalLayout {
        padding: 16px; spacing: 10px;
        if CallLink.code.length > 0: HorizontalLayout {
            spacing: 16px; alignment: start;
            LinkTab { text: "Connection"; on: !root.privacy; clicked => { root.privacy = false; } }
            LinkTab { text: "Privacy"; on: root.privacy; clicked => { root.privacy = true; } }
        }
        if !root.privacy || CallLink.code.length == 0: VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 80px; border-radius: 6px; background: Theme.sunken; clip: true;
                accessible-role: image;
                accessible-label: "Ping over the last five minutes, up to " + CallLink.graph-top + " ms";
                Rectangle { y: 0px; height: 1px; background: Theme.line; }
                Rectangle { y: parent.height / 2; height: 1px; background: Theme.line; }
                Path {
                    width: parent.width; height: parent.height;
                    viewbox-width: 300; viewbox-height: 100;
                    commands: CallLink.graph;
                    stroke: Theme.link; stroke-width: 2px;
                }
                Text { x: 6px; y: 4px; text: CallLink.graph-top + " ms"; color: Theme.muted; font-size: 11px; }
                Text { x: 6px; y: parent.height / 2 + 4px; text: CallLink.graph-top / 2 + " ms"; color: Theme.muted; font-size: 11px; }
            }
            LinkRow { label: "Average ping:"; value: CallLink.average != "" ? CallLink.average : "Unknown"; }
            if CallLink.ping != "": LinkRow { label: "Last ping:"; value: CallLink.ping; }
            if CallLink.loss != "": LinkRow { label: "Outbound packet loss rate:"; value: CallLink.loss; }
            Text {
                text: "You may notice delayed audio at 250 ms or higher. If the problem persists, disconnect and try again."
                    + (CallLink.loss != "" ? " You may sound robotic if your packet loss rate is over 10%." : "");
                color: Theme.muted; font-size: 13px; wrap: word-wrap;
            }
        }
        if root.privacy && CallLink.code.length > 0: VerticalLayout {
            spacing: 10px;
            Text { text: "Voice Privacy Code"; color: Theme.text; font-size: 15px; font-weight: 700; }
            Text {
                text: "A new code is generated when people join or leave this call. Compare it with the others in the call: everyone sees the same numbers.";
                color: Theme.secondary; font-size: 13px; wrap: word-wrap;
            }
            Rectangle {
                height: code-rows.preferred-height; border-radius: 6px; background: Theme.sunken;
                code-rows := VerticalLayout {
                    padding: 10px; spacing: 6px;
                    for row in [0, 1]: HorizontalLayout {
                        for column in [0, 1, 2]: Text {
                            horizontal-stretch: 1; horizontal-alignment: center;
                            text: CallLink.code[row * 3 + column]; color: Theme.text;
                            font-size: 18px; font-weight: 700;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                ActionButton {
                    text: root.copied ? "Copied" : "Copy"; small: true;
                    icon: @image-url("icons/copy.svg");
                    clicked => {
                        root.copy(CallLink.code[0] + " " + CallLink.code[1] + " " + CallLink.code[2] + " "
                            + CallLink.code[3] + " " + CallLink.code[4] + " " + CallLink.code[5]);
                        root.copied = true;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Text {
                text: "Only you and the others in this call can hear you. Nobody else, not even Discord, can listen in.";
                color: Theme.secondary; font-size: 13px; wrap: word-wrap;
            }
        }
        Rectangle {
            height: notice.preferred-height; border-radius: 6px; background: Theme.live.with-alpha(0.12);
            notice := HorizontalLayout {
                padding: 8px; spacing: 8px;
                Image { source: @image-url("icons/lock.svg"); width: 16px; colorize: Theme.live; image-fit: contain; }
                Text {
                    text: CallLink.end-to-end ? "End-to-end encrypted" : "Secure connection";
                    color: Theme.live; font-size: 13px; font-weight: 700; vertical-alignment: center;
                }
            }
        }
    }
}

// One of the voice panel's wide buttons under the status, as Discord's panel
// has for the camera and the screen: lit while what it starts is on.
component DockButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> on;
    callback clicked;
    height: 32px; border-radius: 8px;
    background: root.on ? (touch.has-hover ? Theme.live.with-alpha(0.32) : Theme.live.with-alpha(0.22))
        : touch.has-hover && root.enabled ? Theme.hover : Theme.raised;
    animate background { duration: Theme.quick; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        source: root.icon; width: 20px; height: 20px;
        colorize: !root.enabled ? Theme.faint : root.on || touch.has-hover ? Theme.text : Theme.secondary;
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
        clicked => { Tip.text = ""; root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.label; Tip.side = 0;
                Tip.x = root.absolute-position.x + root.width / 2; Tip.y = root.absolute-position.y;
            } else if Tip.text == root.label {
                Tip.text = "";
            }
        }
    }
}

// What the voice connection is doing, above the account panel, with a way to
// leave the call or to dismiss what went wrong; during a call, the camera and
// sharing the screen, and while sharing, that it's live, wherever the window is.
export component VoiceDock inherits Rectangle {
    in property <string> voice-status;
    /// How long the call has lasted, as 12:05.
    in property <string> voice-time;
    in property <string> voice-detail;
    in property <string> voice-name;
    in property <color> voice-color;
    in property <bool> voice-active;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <string> voice-warning;
    in property <string> voice-error;
    in property <bool> can-share;
    in property <bool> sharing;
    in property <bool> share-live;
    in property <string> share-status;
    /// How many watch this account's stream.
    in property <int> share-watchers;
    in property <bool> can-film;
    in property <bool> camera-on;
    /// The camera is on its way, until its first picture.
    in property <bool> camera-starting;
    callback leave-voice;
    callback dismiss-voice-error;
    callback toggle-camera;
    callback toggle-share;
    /// Sharing starts from a menu, opened at this point in the window.
    callback open-share-menu(length, length);
    /// The call's connection in detail, from where its status is.
    callback open-call-link(length, length, length, length);
    background: Theme.panel;
    VerticalLayout {
        padding-top: 10px; padding-bottom: 8px; padding-right: 8px; spacing: 6px;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 64px;
                if !CallLink.measured || !root.voice-ready: Image {
                    x: 24px; width: 24px; height: 24px; source: @image-url("icons/volume-2.svg");
                    image-fit: contain; colorize: root.voice-color;
                }
                if CallLink.measured && root.voice-ready: SignalIcon {
                    x: 24px; width: 24px; height: 24px; quality: CallLink.quality;
                }
                LinkTouch { open(x, y, width, height) => { root.open-call-link(x, y, width, height); } }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-height: status-text.min-height; preferred-height: status-text.preferred-height;
                status-text := VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.voice-status; color: root.voice-color; font-size: 15px; font-weight: 700; overflow: elide; }
                        if root.voice-time != "": Text {
                            text: root.voice-time; color: Theme.muted; font-size: 13px; vertical-alignment: center;
                            accessible-label: "Call time " + root.voice-time;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.voice-active: Text { text: root.voice-detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                }
                LinkTouch { open(x, y, width, height) => { root.open-call-link(x, y, width, height); } }
            }
            if root.voice-active: IconButton {
                icon: @image-url("icons/phone-off.svg"); label: "Leave voice"; danger: true;
                enabled: !root.voice-leaving;
                clicked => { root.leave-voice(); }
            }
        }
        if root.voice-active && root.sharing: HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 64px;
                if root.share-live: LivePill { x: 36px - self.width / 2; }
                if !root.share-live: Image {
                    x: 26px; width: 20px; height: 20px; source: @image-url("icons/screen-share.svg");
                    image-fit: contain; colorize: Theme.accent;
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text { text: "Your screen"; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                Text {
                    text: !root.share-live ? root.share-status
                        : root.share-watchers > 0 ? "Streaming to " + root.voice-name + " · " + root.share-watchers + " watching"
                        : "Streaming to " + root.voice-name;
                    color: Theme.muted; font-size: 13px; overflow: elide;
                }
            }
            IconButton {
                icon: @image-url("icons/screen-share-off.svg"); label: "Stop sharing"; danger: true;
                clicked => { root.toggle-share(); }
            }
        }
        if root.voice-active && (root.can-film || root.can-share || root.sharing): HorizontalLayout {
            padding-left: 8px; spacing: 8px;
            if root.can-film: DockButton {
                horizontal-stretch: 1; enabled: root.voice-ready; on: root.camera-on;
                icon: root.camera-on ? @image-url("icons/video.svg") : @image-url("icons/video-off.svg");
                label: root.camera-starting ? "Starting camera..." : root.camera-on ? "Turn off camera" : "Turn on camera";
                opacity: root.camera-starting ? (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg)) : 1;
                clicked => { root.toggle-camera(); }
            }
            if root.can-share || root.sharing: DockButton {
                horizontal-stretch: 1; enabled: root.voice-ready; on: root.sharing;
                icon: root.sharing ? @image-url("icons/screen-share-off.svg") : @image-url("icons/screen-share.svg");
                label: root.sharing ? "Stop sharing" : "Share your screen";
                clicked => {
                    if root.sharing {
                        root.toggle-share();
                    } else {
                        root.open-share-menu(self.absolute-position.x, self.absolute-position.y);
                    }
                }
            }
        }
        // Wrapped in the dock's width; a scroll view would neither wrap nor stay short.
        if root.voice-warning != "" && root.voice-error == "": HorizontalLayout {
            padding-left: 64px;
            Label { text: root.voice-warning; color: Theme.accent; }
        }
        if root.voice-error != "": HorizontalLayout {
            padding-left: 64px;
            Text { text: root.voice-error; color: Theme.text; font-size: 14px; wrap: word-wrap; }
        }
        if !root.voice-active: HorizontalLayout {
            padding-left: 54px;
            ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismiss-voice-error(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// A DM's call this account isn't in: who is, and a way to join it, or to
// answer it when it rings.
export component CallInvite inherits VerticalLayout {
    in property <[PersonRow]> call-people;
    in property <string> call-note;
    in property <bool> call-incoming;
    in property <string> call-room;
    in property <bool> can-join;
    callback answer-call(string, bool);
    padding: 20px; spacing: 12px; alignment: center;
    HorizontalLayout {
        alignment: center; spacing: 8px;
        for person in root.call-people: Avatar {
            size: 56px; initial: person.initial; tint: person.tint; picture: person.picture;
            accessible-role: image; accessible-label: person.name;
        }
    }
    Text { text: root.call-note; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center; spacing: 16px;
        if root.call-incoming: CallButton {
            icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
            clicked => { root.answer-call(root.call-room, false); }
        }
        CallButton {
            icon: @image-url("icons/phone.svg"); label: root.call-incoming ? "Accept" : "Join the call";
            fill: Theme.live; enabled: root.can-join;
            clicked => { root.answer-call(root.call-room, true); }
        }
    }
}

// A voice channel this account isn't in: what it is, and a way to join.
export component JoinVoice inherits VerticalLayout {
    in property <string> room-name;
    in property <string> voice-description;
    in property <bool> preview;
    in property <bool> call-encrypted;
    in property <bool> voice-active;
    in property <bool> can-join;
    callback join-voice;
    padding: 32px; spacing: 14px; alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
            Image { source: @image-url("icons/volume-2.svg"); width: 38px; height: 38px; colorize: Theme.secondary; }
        }
    }
    Text { text: root.room-name; color: Theme.text; font-size: 26px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
    Text { text: root.voice-description; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
    if !root.preview && !root.call-encrypted: Text { text: "This channel is unencrypted. Yapfast only joins encrypted voice channels."; color: Theme.accent; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center; padding-top: 6px;
        ActionButton { min-height: 42px; text: root.voice-active ? "Switch voice channel" : "Join voice"; primary: true; enabled: root.can-join; clicked => { root.join-voice(); } }
    }
}

// The stream being watched, over the stage, with whose it is and a way to stop.
export component StreamView inherits Rectangle {
    in property <string> watch-title;
    in property <string> watch-status;
    in property <image> watch-frame;
    /// The stream is live: this account's own isn't until Discord has started it.
    in property <bool> live: true;
    in property <string> stop-label: "Stop watching";
    in property <[PersonRow]> viewers;
    in property <string> viewer-names;
    callback stop-watching;
    vertical-stretch: 1;
    Rectangle {
        x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 12px;
        border-radius: 12px; background: #000000; clip: true;
        accessible-role: image; accessible-label: root.watch-title;
        Image { width: parent.width; height: parent.height; source: root.watch-frame; image-fit: contain; }
        // The stage is black in every theme, so its note is a fixed grey.
        if root.watch-frame.width == 0: Text {
            width: parent.width; height: parent.height;
            text: root.watch-status; color: #b5b8c1; font-size: 15px;
            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
        }
        Rectangle {
            x: 12px; y: 12px; height: 28px;
            width: min(parent.width - 72px, watch-chip.preferred-width);
            border-radius: 6px; background: #000000a6;
            watch-chip := HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 8px;
                Text { text: root.watch-title; color: #ffffff; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                if root.live: Middle { LivePill { } }
            }
        }
        ViewerStack {
            x: parent.width - self.width - 50px; y: 11px;
            viewers: root.viewers; names: root.viewer-names;
        }
        IconButton {
            x: parent.width - self.width - 10px; y: 10px; height: self.size;
            icon: @image-url("icons/x.svg"); label: root.stop-label; tint: #ffffff;
            fill: #000000a6; radius: 16px;
            clicked => { root.stop-watching(); }
        }
    }
}

// A stream kept in a corner of the window while its call isn't on screen, as
// Discord's picture in picture is: the stream being watched, or else this
// account's own screen. A click returns to the call; a drag moves it, and
// `dropped` asks the window for the nearest corner.
export component StreamPip inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <image> frame;
    in property <bool> live;
    in property <image> stop-icon;
    in property <string> stop-label;
    in property <[PersonRow]> viewers;
    in property <string> viewer-names;
    /// How far the pointer has dragged it from its corner.
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    out property <bool> dragging;
    callback open-call;
    callback stop;
    callback dropped;
    width: 320px; height: 180px; border-radius: 8px; clip: true;
    background: #000000;
    border-width: 1px; border-color: Theme.edge;
    accessible-role: button; accessible-label: root.title + ". Return to the call";
    accessible-action-default => { root.open-call(); }
    Image { width: parent.width; height: parent.height; source: root.frame; image-fit: contain; }
    // The stage is black in every theme, so its note is a fixed grey.
    if root.frame.width == 0: Text {
        x: 16px; width: parent.width - 32px; height: parent.height;
        text: root.status; color: #b5b8c1; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    if root.live: LivePill { x: 8px; y: 8px; }
    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        moved => {
            if !self.pressed { return; }
            if !root.dragging && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragging = true;
            }
            if root.dragging {
                root.drag-x += self.mouse-x - self.pressed-x;
                root.drag-y += self.mouse-y - self.pressed-y;
            }
        }
        pointer-event(event) => {
            if event.kind != PointerEventKind.up || event.button != PointerEventButton.left { return; }
            if root.dragging {
                root.dragging = false;
                root.dropped();
            } else {
                root.open-call();
            }
        }
        // Inside the touch area, so the pointer on the stop button still hovers it.
        if self.has-hover && !root.dragging: Rectangle {
            background: @linear-gradient(180deg, #00000000 55%, #000000b0 100%);
            Text {
                x: 12px; y: parent.height - 34px; width: parent.width - 60px; height: 24px;
                text: root.title; color: #ffffff; font-size: 14px; font-weight: 700;
                vertical-alignment: center; overflow: elide;
            }
            IconButton {
                x: parent.width - self.width - 8px; y: parent.height - self.size - 8px; height: self.size;
                icon: root.stop-icon; label: root.stop-label; tint: #ffffff;
                fill: #000000a6; radius: 16px;
                clicked => { root.stop(); }
            }
        }
        ViewerStack {
            x: parent.width - self.width - 8px; y: 8px;
            viewers: root.viewers; names: root.viewer-names;
        }
    }
}

// The call's participants as tiles in a grid.
export component ParticipantGrid inherits Flickable {
    in property <[PersonRow]> participants;
    /// Each participant's newest camera picture, in the same order.
    in property <[image]> frames;
    /// This account's camera is on its way, until its first picture.
    in property <bool> camera-starting;
    in property <bool> sharing;
    in property <bool> share-live;
    in property <string> share-status;
    in property <image> share-frame;
    in property <[PersonRow]> share-viewers;
    in property <string> share-viewer-names;
    callback watch-stream(string);
    /// A click on this account's own screen, or on itself while it shares:
    /// show the screen large, as a watched stream shows.
    callback show-own-stream;
    /// A right click on someone, with where it was in the window.
    callback open-volume(PersonRow, length, length);
    /// Where the tiles are, so cameras are decoded only for tiles in sight,
    /// at their size: the columns, a tile's width and height, the gap, the
    /// first row's top, how far the grid is scrolled and its height.
    callback tiles(int, length, length, length, length, length, length);
    function report() {
        root.tiles(root.columns, root.tile-width, root.tile-height, root.gap, root.first-row, -root.content-y, root.height);
    }
    init => { self.report(); }
    changed columns => { self.report(); }
    changed tile-width => { self.report(); }
    changed first-row => { self.report(); }
    changed content-y => { self.report(); }
    changed height => { self.report(); }
    vertical-stretch: 1;
    property <length> gap: 12px;
    property <length> inset: 24px;
    property <length> span: self.width - 2 * self.inset;
    // Your shared screen leads the grid.
    property <int> extra: root.sharing ? 1 : 0;
    property <int> count: root.participants.length + self.extra;
    // A few people take the columns, and the size, that make their tiles
    // largest within both the width and the height, so a short call above a
    // DM's messages shows everyone without scrolling. Side by side wins
    // unless stacking makes tiles a tenth larger. More people take tiles at
    // least 240px wide, and scroll.
    pure function fitted(columns: int) -> length {
        let rows = ceil(root.count / columns);
        min(420px, (root.span - (columns - 1) * root.gap) / columns,
            (root.height - 2 * root.inset - (rows - 1) * root.gap) / rows / 0.5625)
    }
    property <int> fewest: max(1, min(self.count, floor((self.span + self.gap) / (240px + self.gap))));
    property <int> best-fit: self.count >= 2 && self.fitted(2) * 1.1 > self.fitted(1)
        ? (self.count >= 3 && self.fitted(3) * 1.1 > self.fitted(2)
            ? (self.count >= 4 && self.fitted(4) * 1.1 > self.fitted(3) ? 4 : 3) : 2)
        : 1;
    property <int> columns: self.count <= 4 ? self.best-fit : self.fewest;
    property <length> tile-width: self.count <= 4
        ? max(160px, self.fitted(self.columns))
        : min(420px, (self.span - (self.columns - 1) * self.gap) / self.columns);
    property <length> tile-height: self.tile-width * 0.5625;
    property <int> rows: ceil(self.count / self.columns);
    property <length> grid-height: self.rows * self.tile-height + max(0, self.rows - 1) * self.gap;
    property <length> grid-width: self.columns * self.tile-width + (self.columns - 1) * self.gap;
    property <length> first-row: max(self.inset, (self.height - self.grid-height) / 2);
    content-height: max(self.height, self.grid-height + 2 * self.inset);
    if root.sharing: Rectangle {
        x: (root.width - root.grid-width) / 2;
        y: root.first-row;
        width: root.tile-width; height: root.tile-height;
        border-radius: 12px; background: #000000; clip: true;
        accessible-role: button;
        accessible-label: "Your screen, " + root.share-status;
        accessible-action-default => { root.show-own-stream(); }
        Image { width: parent.width; height: parent.height; source: root.share-frame; image-fit: contain; }
        if root.share-frame.width == 0: VerticalLayout {
            alignment: center; spacing: 10px;
            // Black in every theme, as a stream's stage.
            Image { height: 34px; source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: #b5b8c1; }
            Text { text: root.share-status; color: #b5b8c1; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
        }
        Rectangle {
            x: 10px; y: parent.height - self.height - 10px;
            width: min(parent.width - 20px, share-chip.preferred-width); height: 26px;
            border-radius: 6px; background: #000000a6;
            share-chip := HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 6px;
                Text { text: "Your screen"; color: #ffffff; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                if root.share-live: Middle { LivePill { } }
                if !root.share-live && root.share-frame.width > 0: Text {
                    text: root.share-status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                }
            }
        }
        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.show-own-stream(); } }
        ViewerStack {
            x: parent.width - self.width - 10px; y: 10px;
            viewers: root.share-viewers; names: root.share-viewer-names;
        }
    }
    for person[position] in root.participants: tile := Rectangle {
        property <int> index: position + root.extra;
        x: (root.width - root.grid-width) / 2 + mod(self.index, root.columns) * (root.tile-width + root.gap);
        y: root.first-row + floor(self.index / root.columns) * (root.tile-height + root.gap);
        width: root.tile-width; height: root.tile-height;
        property <image> frame: person.video ? root.frames[position] : @image-url("");
        property <bool> filmed: self.frame.width > 0;
        border-radius: 12px; background: self.filmed ? #000000 : Theme.raised; clip: true;
        accessible-role: text;
        accessible-label: person.name + ", " + person.status + (person.video ? ", camera on" : "");
        if tile.filmed: Image { width: tile.width; height: tile.height; source: tile.frame; image-fit: contain; }
        if !tile.filmed: Avatar {
            size: min(80px, parent.height * 0.45); initial: person.initial; tint: person.tint; picture: person.picture;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 8px;
            opacity: person.connected ? 1 : 0.5;
        }
        // Drawn over the camera's picture.
        Rectangle {
            border-radius: 12px; border-width: person.speaking ? 3px : 0px; border-color: Theme.live;
        }
        // A click watches someone's stream, or shows this account's own; a right
        // click sets their volumes.
        TouchArea {
            mouse-cursor: person.live ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if person.live && person.local && root.sharing {
                    root.show-own-stream();
                } else if person.live && !person.local {
                    root.watch-stream(person.id);
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.open-volume(person, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        if person.local && root.camera-starting: Rectangle {
            x: 10px; y: 10px; height: 26px;
            width: starting-label.preferred-width + 20px; border-radius: 13px;
            background: #000000a6; opacity: (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg));
            starting-label := Text { text: "Starting camera..."; color: #ffffff; font-size: 13px; font-weight: 700; }
        }
        if person.live && !person.local: Rectangle {
            x: parent.width - self.width - 10px; y: 10px; height: 26px;
            width: watch-label.preferred-width + 20px; border-radius: 13px;
            background: Theme.danger;
            accessible-role: button; accessible-label: "Watch " + person.name + "'s stream";
            accessible-action-default => { root.watch-stream(person.id); }
            watch-label := Text { text: "Watch stream"; color: Theme.on-danger; font-size: 13px; font-weight: 700; }
        }
        Rectangle {
            x: 10px; y: parent.height - self.height - 10px;
            width: min(parent.width - 20px, chip.preferred-width); height: 26px;
            border-radius: 6px; background: #000000a6;
            chip := HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 6px;
                if person.muted && !person.deafened: Image { source: @image-url("icons/mic-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
                if person.deafened: Image { source: @image-url("icons/headphone-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
                Text { text: person.name; color: #ffffff; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                if person.live: Middle { LivePill { } }
                if person.status != "Muted" && person.status != "Deafened" && person.status != "Speaking" && person.status != "Listening": Text {
                    text: person.status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                }
            }
        }
    }
}

// The call's controls under the stage: mute, deafen, the camera, share the
// screen, and leave.
export component CallControls inherits HorizontalLayout {
    in property <bool> muted;
    in property <bool> deafened;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <bool> can-share;
    in property <bool> sharing;
    /// The call carries camera video, and this account's camera is on.
    in property <bool> can-film;
    in property <bool> camera-on;
    /// The camera is on its way, until its first picture.
    in property <bool> camera-starting;
    callback toggle-mute;
    callback toggle-deafen;
    callback toggle-camera;
    callback toggle-share;
    /// Sharing starts from a menu, opened at this point in the window.
    callback open-share-menu(length, length);
    callback leave-voice;
    alignment: center; spacing: 12px; padding: 16px; padding-top: 8px;
    IconButton {
        size: 52px; glyph: 22px; radius: 26px;
        icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
        label: root.muted ? "Unmute" : "Mute"; alert: root.muted; tint: Theme.text;
        enabled: root.voice-ready;
        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
        clicked => { root.toggle-mute(); }
    }
    IconButton {
        size: 52px; glyph: 22px; radius: 26px;
        icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
        label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened; tint: Theme.text;
        enabled: root.voice-ready;
        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
        clicked => { root.toggle-deafen(); }
    }
    if root.can-film: IconButton {
        size: 52px; glyph: 22px; radius: 26px;
        icon: root.camera-on ? @image-url("icons/video.svg") : @image-url("icons/video-off.svg");
        label: root.camera-starting ? "Starting camera..." : root.camera-on ? "Turn off camera" : "Turn on camera"; tint: Theme.text;
        enabled: root.voice-ready; opacity: root.camera-starting ? (0.6 + 0.4 * sin(animation-tick() / 1ms * 0.36deg)) : 1;
        fill: root.camera-on ? Theme.live.with-alpha(0.22) : Theme.raised;
        clicked => { root.toggle-camera(); }
    }
    if root.can-share || root.sharing: IconButton {
        size: 52px; glyph: 22px; radius: 26px;
        icon: root.sharing ? @image-url("icons/screen-share-off.svg") : @image-url("icons/screen-share.svg");
        label: root.sharing ? "Stop sharing" : "Share your screen"; tint: Theme.text;
        enabled: root.voice-ready;
        fill: root.sharing ? Theme.live.with-alpha(0.22) : Theme.raised;
        clicked => {
            if root.sharing {
                root.toggle-share();
            } else {
                root.open-share-menu(self.absolute-position.x, self.absolute-position.y);
            }
        }
    }
    Rectangle {
        width: 76px; height: 52px; border-radius: 26px;
        background: leave-touch.has-hover ? Theme.danger-hover : Theme.danger;
        opacity: root.voice-leaving ? 0.5 : 1;
        accessible-role: button; accessible-label: "Leave voice"; accessible-enabled: !root.voice-leaving;
        accessible-action-default => { if !root.voice-leaving { root.leave-voice(); } }
        Image { source: @image-url("icons/phone-off.svg"); width: 22px; height: 22px; colorize: Theme.on-danger; }
        leave-touch := TouchArea { enabled: !root.voice-leaving; mouse-cursor: MouseCursor.pointer; clicked => { root.leave-voice(); } }
    }
}

// A call ringing this account in a DM that isn't open: who, and a way to answer.
export component IncomingCall inherits Rectangle {
    in property <string> incoming-room;
    in property <string> incoming-name;
    in property <string> incoming-detail;
    in property <string> incoming-initial;
    in property <color> incoming-tint;
    in property <image> incoming-picture;
    callback answer-call(string, bool);
    width: 300px; height: incoming-content.preferred-height;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
    drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
    accessible-role: groupbox;
    accessible-label: "Incoming call from " + root.incoming-name;
    // Clicks on the card never reach what's under it.
    TouchArea { }
    incoming-content := VerticalLayout {
        padding: 20px; spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 92px; height: 92px;
                // A ring that pulses while it rings.
                Rectangle {
                    border-radius: self.width / 2; border-width: 3px; border-color: Theme.live;
                    opacity: 0.45 + 0.4 * sin(animation-tick() / 1ms * 0.36deg);
                }
                Avatar {
                    x: 10px; y: 10px; size: 72px;
                    initial: root.incoming-initial; tint: root.incoming-tint; picture: root.incoming-picture;
                }
            }
        }
        Text { text: root.incoming-name; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        Text { text: root.incoming-detail; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center; spacing: 20px; padding-top: 6px;
            CallButton {
                icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
                clicked => { root.answer-call(root.incoming-room, false); }
            }
            CallButton {
                icon: @image-url("icons/phone.svg"); label: "Accept"; fill: Theme.live;
                clicked => { root.answer-call(root.incoming-room, true); }
            }
        }
    }
}

// Switching voice channels asks first, over everything else, and so does
// joining one to watch a stream. Clicking
// outside or Escape cancels; Enter switches. The dialog stays in the tree
// so it can fade out, keeping its text while it goes.
export component SwitchDialog inherits Rectangle {
    /// It asks; false while it fades out.
    in property <bool> switching;
    in property <string> switch-text;
    /// It joins a call from none, to watch someone's stream.
    in property <bool> joins;
    callback cancel-switch;
    callback confirm-switch;
    /// It takes the keyboard while it asks, and lets it go after.
    public function focus-keys() { switch-keys.focus(); }
    public function release-keys() { switch-keys.clear-focus(); }
    visible: self.opacity > 0;
    opacity: root.switching ? 1 : 0;
    animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    background: #00000099;
    TouchArea { enabled: root.switching; clicked => { root.cancel-switch(); } }
    Rectangle {
        width: min(420px, root.width - 48px); height: switch-content.preferred-height;
        y: (parent.height - self.height) / 2 + (root.switching ? 0px : 10px);
        transform-scale: root.switching ? 1 : 0.96;
        animate y, transform-scale { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: root.joins ? "Watch stream?" : "Switch voice channel?";
        // Clicks on the dialog itself never reach the backdrop.
        TouchArea { enabled: root.switching; }
        switch-keys := FocusScope {
            enabled: root.switching;
            key-pressed(event) => {
                if event.text == Key.Escape { root.cancel-switch(); return accept; }
                if event.text == "\n" { root.confirm-switch(); return accept; }
                return reject;
            }
            switch-content := VerticalLayout {
                padding: 20px; spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 40px; height: 40px; border-radius: 20px; background: Theme.accent-soft;
                            Image { source: @image-url("icons/volume-2.svg"); width: 20px; height: 20px; colorize: Theme.accent; }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px; horizontal-stretch: 1;
                        Text { text: root.joins ? "Watch stream?" : "Switch voice channel?"; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: root.switch-text; color: Theme.secondary; font-size: 15px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    // A fading dialog no longer acts.
                    ActionButton { text: "Cancel"; ghost: true; clicked => { if root.switching { root.cancel-switch(); } } }
                    ActionButton { text: root.joins ? "Join" : "Switch channel"; primary: true; clicked => { if root.switching { root.confirm-switch(); } } }
                }
            }
        }
    }
}

// The microphone's level in the input menu, as a row of segments.
export component InputLevel inherits VerticalLayout {
    /// From 0 to 1.
    in property <float> input-level;
    in property <bool> muted;
    /// Why the level can't be shown, if it can't.
    in property <string> meter-note;
    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
    Text { text: "INPUT LEVEL"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
    HorizontalLayout {
        height: 10px; spacing: 3px;
        accessible-role: progress-indicator;
        accessible-label: "Input level";
        accessible-value: round(root.input-level * 100) + "%" + (root.muted ? ", muted" : "");
        // Muted, the level still shows, in a faded green: heard here, sent nowhere.
        for segment in 24: Rectangle {
            border-radius: 2px;
            background: (segment + 0.5) / 24 > root.input-level ? Theme.line
                : root.muted ? Theme.live.with-alpha(0.4) : Theme.live;
        }
    }
    if root.meter-note != "": Label { text: root.meter-note; }
    if root.meter-note == "" && root.muted: Label { text: "Muted. Nothing you say is sent."; }
}

/// A screen in the share menu, and once it's taken, a picture of it.
export struct ShareScreen { title: string, picture: image }

// A screen to share in the share menu, as a picture with its name under it.
component ScreenCard inherits Rectangle {
    in property <string> text;
    in property <image> picture;
    in property <bool> checked;
    callback clicked;
    border-radius: 6px;
    background: pointer.has-hover ? Theme.active : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    VerticalLayout {
        padding: 4px; spacing: 4px;
        Rectangle {
            height: self.width * 9 / 16;
            border-radius: 4px; background: Theme.sunken; clip: true;
            // Until its picture comes.
            if root.picture.width == 0: Image {
                height: 24px; source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: Theme.faint;
            }
            Image { width: parent.width; height: parent.height; source: root.picture; image-fit: contain; }
            Rectangle {
                border-radius: 4px;
                border-width: root.checked || focus.has-focus ? 2px : 1px;
                border-color: root.checked || focus.has-focus ? Theme.accent : Theme.line;
            }
        }
        Text {
            text: root.text; color: root.checked || pointer.has-hover ? Theme.text : Theme.secondary;
            font-size: 13px; font-weight: root.checked ? 700 : 400;
            horizontal-alignment: center; overflow: elide;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// Going live: what to share, where Yapfast lists it, and the resolution and frame
// rate to share it at.
export component ShareMenu inherits Rectangle {
    /// The screens, then the windows, to share; a pick counts the screens
    /// first.
    in property <[ShareScreen]> screens;
    in property <[string]> windows;
    in-out property <int> pick-source;
    in-out property <int> pick-resolution;
    in-out property <int> pick-fps;
    callback go-live(int, int, int);
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 6px; spacing: 2px;
        if root.screens.length > 0: HorizontalLayout {
            padding-left: 8px; padding-top: 4px; padding-bottom: 4px;
            Text { text: "SCREENS"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        // Two to a row; one alone sits in the middle.
        if root.screens.length > 0: Rectangle {
            property <length> gap: 4px;
            property <length> card: (self.width - self.gap) / 2;
            property <length> card-height: self.card * 9 / 16 + 30px;
            height: ceil(root.screens.length / 2) * (self.card-height + self.gap) - self.gap;
            for screen[index] in root.screens: ScreenCard {
                x: root.screens.length == 1 ? (parent.width - parent.card) / 2 : mod(index, 2) * (parent.card + parent.gap);
                y: floor(index / 2) * (parent.card-height + parent.gap);
                width: parent.card; height: parent.card-height;
                text: screen.title; picture: screen.picture; checked: index == root.pick-source;
                clicked => { root.pick-source = index; }
            }
        }
        if root.windows.length > 0: HorizontalLayout {
            padding-left: 8px; padding-top: root.screens.length > 0 ? 8px : 4px; padding-bottom: 4px;
            Text { text: "WINDOWS"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        if root.windows.length > 0: ScrollView {
            // Five before the list scrolls.
            height: min(5, root.windows.length) * 32px;
            VerticalLayout {
                for window[index] in root.windows: MenuItem {
                    text: window; checked: root.screens.length + index == root.pick-source;
                    clicked => { root.pick-source = root.screens.length + index; }
                }
            }
        }
        HorizontalLayout {
            padding-left: 8px; padding-top: root.screens.length + root.windows.length > 0 ? 8px : 4px; padding-bottom: 4px;
            Text { text: "RESOLUTION"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        for choice[index] in ["720p", "1080p", "Source"]: MenuItem {
            text: choice; checked: index == root.pick-resolution;
            clicked => { root.pick-resolution = index; }
        }
        HorizontalLayout {
            padding-left: 8px; padding-top: 8px; padding-bottom: 4px;
            Text { text: "FRAME RATE"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        for fps in [15, 30, 60]: MenuItem {
            text: fps + " fps"; checked: fps == root.pick-fps;
            clicked => { root.pick-fps = fps; }
        }
        HorizontalLayout {
            padding: 4px; padding-top: 8px;
            ActionButton {
                text: "Go Live"; icon: @image-url("icons/screen-share.svg"); primary: true; horizontal-stretch: 1;
                clicked => { root.go-live(root.pick-source, root.pick-resolution, root.pick-fps); }
            }
        }
    }
}

// Someone's volumes, from a right click on them in a call: their voice, and
// their stream's while they share their screen.
export component VolumeMenu inherits Rectangle {
    in property <string> volume-person;
    in property <string> volume-name;
    in property <bool> volume-live;
    in-out property <int> voice-volume;
    in-out property <int> stream-volume;
    out property <length> content-height: volume-content.preferred-height;
    /// A person, whether it's their stream, the volume, and whether it's
    /// the last of a drag.
    callback volume-changed(string, bool, int, bool);
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox; accessible-label: root.volume-name + "'s volume";
    volume-content := VerticalLayout {
        padding: 12px; spacing: 12px;
        Text { text: root.volume-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
        VolumeSlider {
            label: "User volume";
            value <=> root.voice-volume;
            changed(volume) => { root.volume-changed(root.volume-person, false, volume, false); }
            committed(volume) => { root.volume-changed(root.volume-person, false, volume, true); }
        }
        if root.volume-live: VolumeSlider {
            label: "Stream volume";
            value <=> root.stream-volume;
            changed(volume) => { root.volume-changed(root.volume-person, true, volume, false); }
            committed(volume) => { root.volume-changed(root.volume-person, true, volume, true); }
        }
    }
}
